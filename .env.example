# =====================================================================
# ALBRA AGENT SEED V1.0 — Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in the values you need.
# DO NOT commit .env — it is git-ignored by default.
# Only fill in the providers/infra you actually use. The seed runs
# with zero external dependencies in offline mode.
# =====================================================================

# ---------- LLM PROVIDERS ----------
# At least one provider is required for cognitive functionality.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
# Local Ollama (default http://localhost:11434)
OLLAMA_BASE_URL=

# ---------- DEFAULT MODEL ----------
ALBRA_DEFAULT_PROVIDER=openai
ALBRA_DEFAULT_MODEL=gpt-4o-mini
ALBRA_DEFAULT_TEMPERATURE=0.2
ALBRA_DEFAULT_MAX_TOKENS=2048

# ---------- MEMORY ----------
# short_term | long_term | hybrid
ALBRA_MEMORY_MODE=short_term
ALBRA_MEMORY_BACKEND=sqlite
ALBRA_MEMORY_PATH=./data/memory.db
# For vector memory (optional)
ALBRA_VECTOR_BACKEND=none
ALBRA_VECTOR_DIMENSION=1536

# ---------- SECURITY ----------
ALBRA_GUARDRAILS_ENABLED=true
ALBRA_AUDIT_LOG_PATH=./logs/audit.jsonl
ALBRA_SECRETS_BACKEND=env
# If using vault:
ALBRA_VAULT_URL=
ALBRA_VAULT_TOKEN=

# ---------- OBSERVABILITY ----------
ALBRA_LOG_LEVEL=INFO
ALBRA_LOG_FORMAT=json
ALBRA_LOG_PATH=./logs/agent.log
ALBRA_METRICS_ENABLED=true
ALBRA_TRACING_ENABLED=false
ALBRA_OTEL_ENDPOINT=

# ---------- RUNTIME ----------
ALBRA_API_HOST=0.0.0.0
ALBRA_API_PORT=8000
ALBRA_SESSION_TTL_SECONDS=3600
ALBRA_MAX_CONCURRENT_SESSIONS=100
